# Copy this file to .env.local and fill in what you need.
# Restart `npm run dev` after any change here.

# ---------------------------------------------------------------- storage --
# Dashboard → Settings → API Keys  (both values; URL is also in Connect)
#
# Use the PUBLISHABLE key (sb_publishable_...), not a secret key. Publishable
# keys are meant to be in the browser — row-level security is what protects the
# data, which is why schema.sql enables it. A secret key would bypass RLS.
#
# Leave unset and the app falls back to browser-only localStorage.
# Verify with: npm run check:supabase

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy alternative, still accepted. Supabase deprecates it end of 2026.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ email --
# Server-side only — never prefix these with NEXT_PUBLIC_, or the credentials
# would be bundled into the browser.
#
# Pick ONE provider. Whichever key is present is the one that gets used; set
# EMAIL_PROVIDER (resend | brevo | smtp) to force a choice when several are.
# Leave everything unset and "Email invoice" reports that mail isn't set up;
# the rest of the app keeps working.

# The address invoices are sent from. Required by every provider.
# "Name <you@yourcompany.com>" also works.
MAIL_FROM=

# --- Option A: Resend (recommended) — HTTP, 3,000/month free ---------------
# Needs a domain verified in Resend. Without one you can only email yourself.
RESEND_API_KEY=

# --- Option B: Brevo — HTTP, 300/day free, no DNS needed -------------------
# Verify a single sender address instead of a whole domain. Free plan adds
# Brevo branding — send yourself a test before using it for client invoices.
BREVO_API_KEY=

# --- Option C: SMTP — works anywhere, dying on Microsoft 365 ---------------
# Microsoft 365 work account:  smtp.office365.com : 587
# Gmail / Workspace app pwd:   smtp.gmail.com     : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to true for port 465, false otherwise (STARTTLS).
SMTP_SECURE=

# Optional override if several providers are configured at once.
EMAIL_PROVIDER=
